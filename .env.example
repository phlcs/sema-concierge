# ─── Banco ────────────────────────────────────────────────────────────────────
# PostgreSQL. Em dev: gerada automaticamente pelo docker-compose.
# Em produção (Railway): auto-injetada pelo plugin Postgres — não precisa configurar.
DATABASE_URL="postgresql://contador:contador_dev@localhost:5432/pergunteaosecontador"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Segredo para assinar tokens JWT. Em produção, gere com:
#   openssl rand -base64 64
# Use valores DIFERENTES para staging e produção.
JWT_SECRET="troque-por-segredo-longo-e-aleatorio-aqui"

# ─── IA ───────────────────────────────────────────────────────────────────────
# Provider ativo: anthropic | gemini
AI_PROVIDER=anthropic

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Google Gemini — https://ai.google.dev
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Rate limit ───────────────────────────────────────────────────────────────
# Redis. Em dev: gerado automaticamente pelo docker-compose.
# Em produção (Railway): auto-injetada pelo plugin Redis — não precisa configurar.
REDIS_URL=redis://localhost:6379

# Limites de uso do chat
DAILY_GLOBAL_LIMIT=200
DAILY_USER_LIMIT=5
MIN_SECONDS_BETWEEN_MESSAGES=8

# Webhook de alerta (opcional) — notificação quando limite global atingir 80%
ALERT_WEBHOOK_URL=

# ─── Integrações ──────────────────────────────────────────────────────────────
# Troque MODE de "mock" para "real" quando tiver as credenciais de produção.
# Com MODE=mock, nenhuma chamada externa é feita — tudo é simulado localmente.

# Cal.com — agendamento de slots
# Credencial: https://app.cal.com/settings/developer/api-keys
CALCOM_MODE=mock
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Kiwify — processamento de pagamento
# Credencial: https://dashboard.kiwify.com.br/settings/integrations
KIWIFY_MODE=mock
KIWIFY_PUBLIC_KEY=
KIWIFY_SECRET_KEY=
KIWIFY_PRODUCT_ID=7CyqdEm
KIWIFY_WEBHOOK_SECRET=

# Resend — envio de e-mails transacionais
# Credencial: https://resend.com/api-keys
RESEND_MODE=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=contato@pergunteaoseucontador.com.br

# Produto — preço e duração da sessão
SESSION_PRICE_CENTS=19700
SESSION_DURATION_MINUTES=60

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Palavra-passe que VOCÊ inventa e cola no painel da Meta na hora de cadastrar
# o webhook. A Meta manda essa palavra de volta no primeiro GET pra confirmar
# que o webhook é mesmo seu.
VERIFY_TOKEN=

# Token do System User do app no WhatsApp Business. É UM só, vale pra todos os
# números conectados ao app. O que diferencia cada cliente é o phone_number_id,
# que fica no banco no registro do Cliente.
WHATSAPP_TOKEN=

# ─── Deploy ───────────────────────────────────────────────────────────────────
# URL pública do ambiente (sem barra final). Usado para og:url, canonical e e-mails.
# Ex.: https://pergunteaoseucontador.com.br (produção)
#      https://staging-xxx.up.railway.app   (staging)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Não defina NODE_ENV manualmente em desenvolvimento.
# Em produção, o Railway define NODE_ENV=production automaticamente.
# NODE_ENV=production
