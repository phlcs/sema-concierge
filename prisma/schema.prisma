generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id             String                 @id @default(cuid())
  nomeNegocio    String
  phoneNumberId  String                 @unique
  wabaId         String?
  whatsappToken  String
  emailPrestador String
  cerebro        Json
  status         String                 @default("ativo")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  conversas      WhatsappConversation[]
}

model WhatsappConversation {
  id            String            @id @default(cuid())
  clienteId     String
  numeroContato String
  handoffEm     DateTime?
  revisar       Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  cliente       Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens     WhatsappMessage[]

  @@unique([clienteId, numeroContato])
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           MessageRole
  texto          String
  createdAt      DateTime             @default(now())
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Demo do Concierge para prospects (POC). Isolada do modelo de cliente real.
model Demo {
  id              String         @id @default(cuid())
  nomeNegocio     String
  numeroExibicao  String
  emailExibicao   String
  cerebro         Json
  token           String         @unique
  expiraEm        DateTime
  status          String         @default("ativo")
  limiteMensagens Int            @default(300)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  mensagens       DemoMensagem[]
}

model DemoMensagem {
  id           String      @id @default(cuid())
  demoId       String
  sessaoId     String
  role         MessageRole
  texto        String
  handoff      Boolean     @default(false)
  leadNome     String?
  leadIntencao String?
  leadResumo   String?
  createdAt    DateTime    @default(now())
  demo         Demo        @relation(fields: [demoId], references: [id])

  @@index([demoId, sessaoId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
}
