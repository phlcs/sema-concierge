generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Cadastro único de prospect e cliente (T7). Prospect existe sem número de
// WhatsApp, só com cérebro e link de teste; ao fechar a venda o mesmo cadastro
// ganha o número e passa a ativo. Status: prospect | ativo | manutencao.
model Cliente {
  id                    String                 @id @default(cuid())
  nomeNegocio           String
  phoneNumberId         String?                @unique
  wabaId                String?
  whatsappToken         String?
  emailPrestador        String
  cerebro               Json
  status                String                 @default("ativo")
  // Link de teste (/demo/{testeToken}): gerado na criação, bloqueado até ser liberado
  testeToken            String                 @unique @default(dbgenerated("(md5((random())::text) || md5((random())::text))"))
  // Nulo ou no passado = bloqueado
  testeLiberadoAte      DateTime?
  // Início da liberação atual: o limite de mensagens conta a partir daqui
  testeLiberadoEm       DateTime?
  testeLimiteMensagens  Int                    @default(300)
  // Número mostrado no topo do link de teste (não é usado para enviar nada)
  numeroExibicao        String?
  // Cadastro de funcionamento (T8), fora do cérebro. camposPedido (T9), remetente e
  // destino (T10) já são lidos pelo atendimento; modo e fallback ficam para a T12.
  // conversao | hospitalidade | resolucao. Nulo = não definido (cliente anterior à T8)
  modo                  String?
  // [{ nome, obrigatorio }], na ordem do cadastro
  camposPedido          Json                   @default("[]")
  // Nome do remetente do e-mail de encaminhamento (ex.: "Concierge Candê")
  nomeRemetente         String?
  // Para onde vai o encaminhamento. Só "email" existe por enquanto
  destinoEncaminhamento String                 @default("email")
  // { principal: { tipo, contato }, sac?, rh?, compras?, imprensa?, urgencia? }
  canaisFallback        Json                   @default("{}")
  // Pasta de busca (vector store) do cliente na OpenAI (T14). Criada no primeiro upload
  vectorStoreId         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  conversas             WhatsappConversation[]
  mensagensTeste        DemoMensagem[]
  encaminhamentos       Encaminhamento[]
  resumosTeste          DemoResumo[]
  documentos            Documento[]
  // Lead Recovery (T02): só relações virtuais, nenhuma coluna nesta tabela
  recuperacaoConfig     RecuperacaoConfig?
  atividadesContato     AtividadeContato[]
  recuperacaoAvaliacoes RecuperacaoAvaliacao[]
  recuperacaoEnvios     RecuperacaoEnvio[]
  recuperacaoBloqueios  RecuperacaoBloqueio[]
}

// Documentos do cliente (T14): PDFs que a IA consulta pela ferramenta buscar_documentos
// e, se marcados, envia pela ferramenta enviar_documento. O arquivo fica aqui (para
// mandar pelo WhatsApp) e uma cópia na pasta de busca do cliente na OpenAI.
model Documento {
  id           String   @id @default(cuid())
  clienteId    String
  // Nome que a IA vê e usa para escolher o que enviar (ex.: "Cardápio")
  nome         String
  arquivoNome  String
  tamanho      Int
  conteudo     Bytes
  // Arquivo na OpenAI (nulo enquanto sobe ou se o upload falhou antes de criar)
  openaiFileId String?
  // processando | pronto | falha
  status       String   @default("processando")
  podeEnviar   Boolean  @default(false)
  createdAt    DateTime @default(now())
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, nome])
}

model WhatsappConversation {
  id                String             @id @default(cuid())
  clienteId         String
  numeroContato     String
  handoffEm         DateTime?
  revisar           Boolean            @default(false)
  // Resumo acumulativo das mensagens que saíram da janela de histórico (T11) e o
  // createdAt da última mensagem já resumida
  resumo            String?
  resumoAte         DateTime?
  // Origem do anúncio de clique para WhatsApp (T50): ctwa_clid, objeto referral
  // inteiro (inclui source_id, o ID do anúncio) e quando o clique chegou
  ctwaClid          String?
  referral          Json?
  referralEm        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cliente           Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens         WhatsappMessage[]
  encaminhamentos   Encaminhamento[]
  // Lead Recovery (T02): relação virtual, sem coluna nesta tabela
  recuperacaoEnvios RecuperacaoEnvio[]

  @@unique([clienteId, numeroContato])
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           MessageRole
  texto          String
  createdAt      DateTime             @default(now())
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Encaminhamentos registrados pela ferramenta registrar_pedido (T9). Servem ao
// limite de 3 novos por dia por conversa e ao estado mostrado à IA. WhatsApp
// grava conversaId; o link de teste grava sessaoId. A bateria não grava.
model Encaminhamento {
  id         String                @id @default(cuid())
  clienteId  String
  conversaId String?
  sessaoId   String?
  // novo | atualizacao | cancelamento (T10)
  tipo       String                @default("novo")
  // [{ nome, valor }], na ordem do cadastro. Na atualização e no cancelamento,
  // o pedido inteiro como ficou (campos já mesclados)
  campos     Json
  intencao   String?
  resumo     String?
  // Atualização: o que mudou, nas palavras da IA. Cancelamento: o motivo
  mudou      String?
  createdAt  DateTime              @default(now())
  cliente    Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  conversa   WhatsappConversation? @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, createdAt])
  @@index([clienteId, sessaoId, createdAt])
}

// Tabela antiga de demos (T7): cada demo virou um Cliente "prospect" com o mesmo
// id. Fica só como cópia de segurança; @@ignore tira do client do Prisma.
// Apagar numa limpeza futura, depois de confirmar a migração.
model Demo {
  id              String   @id
  nomeNegocio     String
  numeroExibicao  String
  emailExibicao   String
  cerebro         Json
  token           String   @unique
  expiraEm        DateTime
  status          String   @default("ativo")
  limiteMensagens Int      @default(300)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@ignore
}

// Mensagens do link de teste. A tabela "Demo" antiga continua no banco só como
// cópia de segurança (T7) e não é usada pelo código; demoId fica como histórico.
model DemoMensagem {
  id           String      @id @default(cuid())
  clienteId    String
  demoId       String?
  sessaoId     String
  role         MessageRole
  texto        String
  handoff      Boolean     @default(false)
  leadNome     String?
  leadIntencao String?
  leadResumo   String?
  createdAt    DateTime    @default(now())
  cliente      Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, sessaoId, createdAt])
}

// Resumo acumulativo de uma sessão do link de teste (T11): mensagens que saíram da
// janela de histórico. Mesmo papel de WhatsappConversation.resumo.
model DemoResumo {
  id        String   @id @default(cuid())
  clienteId String
  sessaoId  String
  resumo    String
  resumoAte DateTime
  updatedAt DateTime @updatedAt
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, sessaoId])
}

// Eventos operacionais (T5). Sem relação com Cliente de propósito: o registro
// sobrevive à exclusão do cliente e também serve a eventos sem cliente. O
// detalhe guarda só identificadores, nunca dados pessoais.
model Evento {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  tema      String
  evento    String
  gravidade String
  clienteId String?
  detalhe   Json?

  @@index([createdAt])
  @@index([tema, gravidade, createdAt])
  @@index([clienteId, createdAt])
}

// Registro técnico de cada chamada de IA (T5). Sem tela nesta tarefa.
model RegistroResposta {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  // whatsapp (cliente real) | teste (link de demo) | bateria
  origem             String
  // resposta | busca_documentos | resumo | transcricao
  funcao             String
  clienteId          String?
  demoId             String?
  conversaId         String?
  provedor           String
  modelo             String
  versaoPrompt       String?
  // Total de entrada, já contando a parte que veio do cache
  tokensEntrada      Int?
  tokensSaida        Int?
  // Parte da entrada lida do cache
  tokensCache        Int?
  // Parte da entrada gravada no cache (só a Anthropic cobra à parte)
  tokensCacheEscrita Int?
  tempoMs            Int
  // [{ nome, resultado }]
  ferramentas        Json?
  custoEstimadoUsd   Float?
  sucesso            Boolean  @default(true)

  @@index([createdAt])
  @@index([clienteId, createdAt])
  @@index([origem, funcao, createdAt])
}

// Interruptor geral de manutenção (T5): uma linha só (id "geral"). Guarda quais
// clientes ELE colocou em manutenção, para "voltar ao normal" restaurar só esses.
// Mexer no botão de um cliente tira o cliente desta lista (o botão do cliente manda).
model InterruptorGeral {
  id          String    @id
  ligado      Boolean   @default(false)
  ligadoEm    DateTime?
  clientesIds String[]
  updatedAt   DateTime  @updatedAt
}

// ─── Lead Recovery (T02) ──────────────────────────────────────────────────────
// Só estrutura de dados. Referência: docs/lead-recovery/T01_ARQUITETURA.md §5,
// com os ajustes descritos em docs/lead-recovery/T02_ESTRUTURA_DADOS.md.
// Os CHECKs, o índice parcial e o gatilho de RecuperacaoEnvio vivem só na
// migração SQL (o Prisma não os declara); ver a migração 20261104120000.

// Configuração do módulo por cliente. SEM LINHA = DESLIGADO.
model RecuperacaoConfig {
  clienteId        String    @id
  // desligado | simulacao | real
  modo             String    @default("desligado")
  // Só contatos com atividade a partir daqui são elegíveis
  ativadoEm        DateTime?
  templateNome     String?
  templateIdioma   String    @default("pt_BR")
  // Corpo exato aprovado na Meta: é o que vai para o histórico do Concierge
  templateCorpo    String?
  // Janela de envio no fuso de Brasília (hora cheia, [horaInicio, horaFim))
  horaInicio       Int       @default(9)
  horaFim          Int       @default(20)
  // 0 = domingo ... 6 = sábado. Padrão: todos os dias
  diasSemana       Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  // Descrição do negócio para o classificador
  descricaoNegocio String?
  atualizadoEm     DateTime  @updatedAt
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// Última entrada do lead, gravada na chegada do webhook (qualquer tipo de mensagem).
model AtividadeContato {
  id                  String    @id @default(cuid())
  clienteId           String
  // normalizarNumero(): só dígitos
  numeroContato       String
  // message.from como veio da Meta (chave do buffer Redis)
  fromBruto           String
  // Relógio do servidor
  ultimaEntradaEm     DateTime
  // message.timestamp da Meta
  ultimaEntradaMetaTs DateTime?
  // wamid da última entrada (referência da Meta)
  ultimoWamid         String?
  ultimoTipo          String
  // Contador incrementado a cada atividade: checagem otimista de concorrência
  versao              Int       @default(1)
  cliente             Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, numeroContato])
  @@index([clienteId, ultimaEntradaEm])
}

// Um ciclo de inatividade avaliado (regras + IA + revisão manual + simulação).
// Várias por contato (uma por referenciaEm). Simulação vive só aqui e nunca
// consome a oportunidade de envio.
model RecuperacaoAvaliacao {
  id                 String             @id @default(cuid())
  clienteId          String
  numeroContato      String
  conversaId         String?
  // AtividadeContato.ultimaEntradaEm no momento da avaliação
  referenciaEm       DateTime
  // simulacao | real: modo do cliente quando foi avaliada
  modo               String
  // pendente | descartada_regra | classificada | erro | erro_definitivo |
  // cancelada_atividade | bloqueada_verificacao | aguardando_revisao |
  // aprovada | rejeitada | enviada | simulado_enviaria
  status             String             @default("pendente")
  // ex.: ja_tentado, encaminhamento, bloqueio, fora_horario
  motivoRegra        String?
  // recuperar | nao_recuperar | incerto
  decisao            String?
  motivo             String?
  evidencias         Json?
  sinais             Json?
  modelo             String?
  versaoPrompt       String?
  registroRespostaId String?
  falhasIa           Int                @default(0)
  revisadoEm         DateTime?
  revisaoMotivo      String?
  // Texto que seria enviado, quando status = simulado_enviaria
  corpoSimulado      String?
  criadoEm           DateTime           @default(now())
  atualizadoEm       DateTime           @updatedAt
  cliente            Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  envios             RecuperacaoEnvio[]

  @@unique([clienteId, numeroContato, referenciaEm, modo])
  // Sustenta a FK composta de RecuperacaoEnvio (envio e avaliação do mesmo contato)
  @@unique([id, clienteId, numeroContato])
  @@index([clienteId, status, criadoEm])
}

// Tentativa REAL de envio. A auditoria sobrevive à exclusão da conversa
// (conversaId vira nulo). Regra de unicidade: no máximo UMA linha que ocupa a
// oportunidade por (clienteId, numeroContato), garantida por índice único
// parcial na migração:
//   WHERE NOT (status = 'rejeitado'
//              OR (status = 'cancelado' AND tentativasMeta = 0
//                  AND wamid IS NULL AND erroCodigo IS NULL AND erroHttp IS NULL))
// Libera nova tentativa: rejeição definitiva da Meta e cancelamento comprovadamente
// anterior a qualquer chamada. Aceito, incerto, enviando e adiado consomem.
model RecuperacaoEnvio {
  id                 String                @id @default(cuid())
  clienteId          String
  numeroContato      String
  conversaId         String?
  avaliacaoId        String
  // enviando | aceito | entregue | lido | falhou | incerto | adiado | rejeitado | cancelado
  status             String
  templateNome       String
  templateIdioma     String
  corpo              String
  wamid              String?               @unique
  // Chamadas feitas à Meta. Gravar 1 (commit) ANTES do HTTP; nunca diminui
  tentativasMeta     Int                   @default(0)
  erroCodigo         Int?
  erroHttp           Int?
  erroTitulo         String?
  categoriaCobranca  String?
  conflitoAtividade  Boolean               @default(false)
  // WhatsappMessage.id, sem FK: a linha do histórico pode ser removida sem perder a auditoria
  mensagemId         String?
  mensagemRemovidaEm DateTime?
  reivindicadoEm     DateTime              @default(now())
  aceitoEm           DateTime?
  entregueEm         DateTime?
  lidoEm             DateTime?
  falhouEm           DateTime?
  incertoEm          DateTime?
  respondidoEm       DateTime?
  atualizadoEm       DateTime              @updatedAt
  cliente            Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  conversa           WhatsappConversation? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  avaliacao          RecuperacaoAvaliacao  @relation(fields: [avaliacaoId, clienteId, numeroContato], references: [id, clienteId, numeroContato], onDelete: NoAction)

  @@index([clienteId, numeroContato])
  @@index([avaliacaoId])
  @@index([status, reivindicadoEm])
}

// Opt-out e supressão. Nunca recupera quem está aqui.
model RecuperacaoBloqueio {
  id            String   @id @default(cuid())
  clienteId     String
  numeroContato String
  // manual | palavra_chave | classificador | meta_131050 | meta_user_preferences
  origem        String
  motivo        String?
  criadoEm      DateTime @default(now())
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, numeroContato])
}

enum MessageRole {
  USER
  ASSISTANT
}
